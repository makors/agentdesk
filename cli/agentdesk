#!/usr/bin/env python3
"""agentdesk: run an AI agent on this Mac concurrently with you, without touching your focus.

It gives the agent (Codex computer-use, or any harness) an ISOLATED, HIDDEN workspace:
  * a hidden virtual display (reused from the running Monitor if present),
  * a SEPARATE process instance of the target app  (never shares key-window state with your copy),
  * every window parked on the hidden display,
  * a background relocator that pulls any dialog the agent opens off your screen automatically.
It sends no keyboard/pointer events and never activates an app. All actuation is exact-window
Accessibility via `axact`, so Codex can drive by (pid, window_id) with the cursor and focus left alone.

Commands:
  agentdesk up                         start the relocator daemon (and confirm hidden display)
  agentdesk launch APP [--file PATH]   launch an isolated hidden instance; park it; print {pid, windows}
  agentdesk register PID               add an already-running pid to the relocator's watch set
  agentdesk park PID                   move all of PID's windows onto the hidden display
  agentdesk act ...                    passthrough to axact (windows|tree|find|set|insert|press|menu|move|focused)
  agentdesk status                     show daemon, hidden display, watched pids
  agentdesk down                       stop the daemon (agent instances keep running)
"""
import json,os,pathlib,subprocess,sys,time,signal
HERE=pathlib.Path(__file__).resolve().parent
HOME=pathlib.Path(os.environ.get('AGENTDESK_HOME', str(pathlib.Path.home()/'.agentdesk'))).expanduser()
ROOT=HOME/'runtime';ROOT.mkdir(parents=True,exist_ok=True)
def _tool(name):
    # helper binaries live beside this script (source/dev or brew libexec); fall back to ~/.agentdesk/bin
    for c in (HERE/name, HOME/'bin'/name):
        if c.exists():return c
    return HERE/name
AXACT=_tool('axact');DAEMON=_tool('agentdesk-daemon')
REG=ROOT/'agents.json';PIDF=ROOT/'daemon.pid';RELOG=ROOT/'relocations.jsonl'
DISP=_tool('hidden-display');DPID=ROOT/'display.pid';DSTATE=ROOT/'display.json'
def displays():
    import ctypes
    cg=ctypes.CDLL('/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics')
    n=ctypes.c_uint32();ids=(ctypes.c_uint32*16)();cg.CGGetActiveDisplayList(16,ids,ctypes.byref(n))
    class R(ctypes.Structure):_fields_=[('x',ctypes.c_double),('y',ctypes.c_double),('w',ctypes.c_double),('h',ctypes.c_double)]
    cg.CGDisplayBounds.restype=R;main=cg.CGMainDisplayID()
    out=[]
    for i in range(n.value):
        b=cg.CGDisplayBounds(ids[i]);out.append({'id':ids[i],'bounds':[b.x,b.y,b.w,b.h],'main':ids[i]==main})
    return out
def hidden_rect():
    for d in displays():
        if not d['main']:return d['bounds']
    return None
def load_reg():
    try:return json.loads(REG.read_text())
    except Exception:return {'pids':[],'hidden':hidden_rect() or [1512,0,1920,1200],'margin':90,'desks':{}}
def save_reg(r):REG.write_text(json.dumps(r))
def display_alive():
    try:pid=int(DPID.read_text());os.kill(pid,0);return pid
    except Exception:return None
def ensure_display():
    if hidden_rect():return {'hidden_display':'already present','bounds':hidden_rect()}
    p=subprocess.Popen([str(DISP),str(DSTATE),'corner'],stdout=open(ROOT/'display.log','a'),stderr=subprocess.STDOUT,start_new_session=True)
    DPID.write_text(str(p.pid))
    for _ in range(40):
        if hidden_rect():break
        if p.poll() is not None:raise RuntimeError('hidden-display exited')
        time.sleep(0.2)
    return {'hidden_display':'started','pid':p.pid,'bounds':hidden_rect()}
def daemon_alive():
    try:pid=int(PIDF.read_text());os.kill(pid,0);return pid
    except Exception:return None
def axact(*a):
    r=subprocess.run([str(AXACT),*map(str,a)],capture_output=True,text=True,timeout=30);return r.returncode,r.stdout.strip(),r.stderr.strip()
def resolve_app(app):
    import glob,os
    # already a concrete .app path
    if app.endswith('.app') and os.path.isdir(app):return app
    for cand in [f'/Applications/{app}.app', f'/Applications/Utilities/{app}.app',
                 os.path.expanduser(f'~/Applications/{app}.app')]:
        if os.path.isdir(cand):return cand
    # search: a folder or .app whose name contains the term (e.g. 'Adobe Illustrator 2026')
    hits=[]
    for pat in [f'/Applications/*{app}*/*.app', f'/Applications/*{app}*.app',
                f'/Applications/**/{app}*.app']:
        hits+=glob.glob(pat, recursive=True)
    # prefer the shortest path (the main app, not a helper), de-duplicated
    hits=sorted(set(h for h in hits if '/Contents/' not in h), key=len)
    return hits[0] if hits else None
def pidof(name):
    import os.path
    needle=os.path.basename(name).replace('.app','')
    rc,o,e=axact('pidof',needle)
    try:return [(int(x['pid']),x.get('active',False)) for x in json.loads(o)]
    except Exception:return []
def wins(pid):
    rc,o,e=axact('windows',pid)
    try:return json.loads(o)
    except Exception:return []
def ensure_up():
    ensure_display();h=hidden_rect()
    if not h:raise RuntimeError("Could not create a hidden display.")
    r=load_reg();r['hidden']=h;save_reg(r)
    if daemon_alive():return {'daemon':'already running','pid':daemon_alive(),'hidden':h}
    p=subprocess.Popen([str(DAEMON),str(ROOT)],stdout=open(ROOT/'daemon.log','a'),stderr=subprocess.STDOUT,start_new_session=True)
    PIDF.write_text(str(p.pid));time.sleep(0.5)
    return {'daemon':'started','pid':p.pid,'hidden':h,'watching':r['pids']}
def up():
    print(json.dumps(ensure_up()))
def park(pid):
    r=load_reg();h=r['hidden'];margin=90;moved=[]
    desk=r.setdefault('desks',{}).setdefault(str(pid),{});orig=desk.setdefault('orig',{})
    for w in wins(pid):
        b=w['bounds']
        # record the true original position the first time we see this window still on the main display
        if str(w['wid']) not in orig and b[0]<h[0]:
            orig[str(w['wid'])]=[int(b[0]),int(b[1])]
        rc,o,e=axact('move',pid,w['wid'],int(h[0]+margin),int(h[1]+margin));moved.append({'wid':w['wid'],'ok':'"ok":true' in o})
    save_reg(r)
    return moved
def register(pid, meta=None):
    r=load_reg()
    if pid not in r['pids']:r['pids'].append(pid)
    r.setdefault('desks',{})
    d=r['desks'].setdefault(str(pid),{})
    if meta:d.update(meta)
    d.setdefault('orig',{})
    save_reg(r);return r['pids']
def launch(app,file=None):
    if not (daemon_alive() and hidden_rect()):ensure_up()
    import os.path
    before={pid for pid,_ in pidof(app)}
    target=resolve_app(app) or app
    r0=subprocess.run(['open','-n','-gj',target] if target.endswith('.app') else ['open','-n','-gj','-a',target],capture_output=True,text=True)
    launch_err=r0.stderr.strip()
    newpid=None
    for _ in range(20):  # ~4s: wait for a NEW process (separate instance)
        cand=[pid for pid,_ in pidof(app) if pid not in before]
        if cand:newpid=cand[0];break
        time.sleep(0.2)
    if newpid is not None:
        pid=newpid;mode='separate_process'
    else:
        # single-instance app (e.g. Adobe): adopt the running instance
        allp=pidof(app)
        if not allp:return print(json.dumps({'error':'app did not launch or was not found','app':app,'resolved':target,'open_error':launch_err}))or sys.exit(1)
        pid=allp[0][0];mode='shared_instance'
    register(pid, {'mode':mode,'owns_launch':(mode=='separate_process'),'app':app})  # remember who owns this instance
    # hide_park_unhide: keep a freshly-launched app hidden while its window/AX initializes,
    # park it onto the hidden display, then unhide it there — avoids a launch-time flash on the user's screen.
    hidden_launch = (mode=='separate_process')
    if hidden_launch:
        for _ in range(6): axact('hide',pid); time.sleep(0.05)   # some apps un-hide themselves during init
    parked=[]
    for _ in range(40):  # up to ~8s: wait for a real window, then park it
        w=wins(pid)
        if w:
            if hidden_launch: axact('hide',pid)  # ensure hidden right before the move
            parked=park(pid)
            if parked and all(x.get('ok') for x in parked): break
        time.sleep(0.2)
    if hidden_launch:
        axact('unhide',pid)   # now visible only on the hidden display
        time.sleep(0.2); park(pid)
    if file:
        subprocess.run((['open','-gj',target,file] if target.endswith('.app') else ['open','-gj','-a',target,file]));time.sleep(1.5);park(pid)
    warn=None
    if mode=='shared_instance':
        warn=('This app refuses a second process, so the agent shares the one running instance. '
              'Safe if you are not using this app yourself. If you are actively working in it, do not run the agent here.')
    out={'pid':pid,'app':app,'mode':mode,'parked':parked,'windows':wins(pid),
         'note':'drive this pid/window with your background computer use; do NOT bring it to the front. Dialogs auto-relocate.'}
    if warn:out['warning']=warn
    print(json.dumps(out,indent=1))
def close_desk(pid):
    import signal as _sig
    r=load_reg()
    desk=r.get('desks',{}).get(str(pid),{})
    owns=desk.get('owns_launch', False)  # unknown ownership -> never terminate (safe default)
    if str(pid) not in r.get('desks',{}):
        owns=False   # no record of launching it -> assume it is the user's; never terminate
    orig=desk.get('orig',{})
    # 1) un-watch so the relocator stops touching it
    if pid in r['pids']:r['pids'].remove(pid)
    r.get('desks',{}).pop(str(pid),None);save_reg(r)
    # 2) restore each window to where it was before we parked it
    restored=[]
    for wid,xy in orig.items():
        o=axact('move',str(pid),wid,int(xy[0]),int(xy[1]));restored.append({'wid':int(wid),'ok':'"ok":true' in o})
    # 3) lifecycle: only quit an instance WE launched; never terminate the user's adopted app
    action=None
    if owns:
        try:os.kill(pid,_sig.SIGTERM);action='quit agent-launched instance (SIGTERM, honors save prompts)'
        except ProcessLookupError:action='already gone'
        except Exception as e:action='quit failed: '+str(e)
    else:
        action='left your app running (adopted instance); un-watched and restored its window(s)'
    return {'closed_pid':pid,'owns_launch':owns,'restored':restored,'watching':load_reg()['pids'],'note':action}
def status():
    r=load_reg();print(json.dumps({'daemon_pid':daemon_alive(),'display_pid':display_alive(),'hidden_display':hidden_rect(),'watching_pids':r['pids'],'relocations':sum(1 for _ in open(RELOG)) if RELOG.exists() else 0},indent=1))
def down():
    out={}
    pid=daemon_alive()
    if pid:os.kill(pid,signal.SIGTERM);out['daemon']='stopped'
    else:out['daemon']='not running'
    dp=display_alive()
    if dp:os.kill(dp,signal.SIGTERM);out['hidden_display']='stopped'
    else:out['hidden_display']='not running (or external)'
    time.sleep(1);print(json.dumps(out))
def main():
    a=sys.argv[1:]
    if not a:print(__doc__);return
    c=a[0]
    if c=='up':up()
    elif c=='down':down()
    elif c=='status':status()
    elif c=='launch':
        app=a[1];file=None
        if '--file' in a:file=a[a.index('--file')+1]
        launch(app,file)
    elif c=='register':print(json.dumps({'watching':register(int(a[1]),{'owns_launch':False,'mode':'adopted'})}))
    elif c=='park':print(json.dumps({'parked':park(int(a[1]))}))
    elif c=='close':print(json.dumps(close_desk(int(a[1]))))
    elif c=='mcp':
        srv=HERE/'agentdesk_mcp.py'
        if not srv.exists():srv=HOME/'mcp'/'agentdesk_mcp.py'
        import shutil
        py=shutil.which('python3') or '/usr/bin/python3'
        print(f"MCP server: {srv}\n\nPaste into ~/.codex/config.toml (ChatGPT/Codex app):\n")
        print(f'[mcp_servers.agentdesk]\ncommand = "{py}"\nargs = ["{srv}"]\nstartup_timeout_sec = 30')
    elif c=='act':print(axact(*a[1:])[1])
    else:print(__doc__)
if __name__=='__main__':main()
